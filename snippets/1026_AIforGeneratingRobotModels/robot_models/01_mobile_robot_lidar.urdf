<?xml version="1.0"?>
<robot name="diff_drive_robot">

  <!-- ===================== MATERIALS ===================== -->
  <material name="chassis_gray">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="mast_blue">
    <color rgba="0.2 0.4 0.9 1.0"/>
  </material>
  <material name="sensor_red">
    <color rgba="0.9 0.1 0.1 1.0"/>
  </material>

  <!-- ===================== BASE / CHASSIS ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.30 0.12"/>
      </geometry>
      <material name="chassis_gray"/>
    </visual>
  </link>

  <!-- ===================== WHEELS (continuous joints) ===================== -->

  <!-- Front Left Wheel -->
  <link name="wheel_front_left">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.04"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
  </link>
  <joint name="joint_wheel_front_left" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_left"/>
    <origin xyz="0.13 0.17 -0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Front Right Wheel -->
  <link name="wheel_front_right">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.04"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
  </link>
  <joint name="joint_wheel_front_right" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_right"/>
    <origin xyz="0.13 -0.17 -0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear Left Wheel -->
  <link name="wheel_rear_left">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.04"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
  </link>
  <joint name="joint_wheel_rear_left" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_left"/>
    <origin xyz="-0.13 0.17 -0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear Right Wheel -->
  <link name="wheel_rear_right">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.04"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
  </link>
  <joint name="joint_wheel_rear_right" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_right"/>
    <origin xyz="-0.13 -0.17 -0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ===================== SENSOR MAST (fixed joint) ===================== -->
  <link name="sensor_mast">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.12"/>
      </geometry>
      <material name="mast_blue"/>
    </visual>
  </link>
  <joint name="joint_sensor_mast" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_mast"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  <!-- ===================== LIDAR / SENSOR HEAD (revolute joint, demonstrates pan) ===================== -->
  <link name="sensor_head">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.03"/>
      </geometry>
      <material name="sensor_red"/>
    </visual>
  </link>
  <joint name="joint_sensor_head" type="revolute">
    <parent link="sensor_mast"/>
    <child link="sensor_head"/>
    <origin xyz="0 0 0.135" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="1.0" velocity="1.0"/>
  </joint>

</robot>