<?xml version="1.0"?>
<robot name="simple_3dof_arm">

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="blue">
    <color rgba="0.2 0.4 0.8 1"/>
  </material>
  <material name="green">
    <color rgba="0.2 0.7 0.3 1"/>
  </material>
  <material name="orange">
    <color rgba="0.9 0.5 0.1 1"/>
  </material>
  <material name="dark_gray">
    <color rgba="0.25 0.25 0.25 1"/>
  </material>
  <material name="black">
    <color rgba="0.05 0.05 0.05 1"/>
  </material>

  <!-- Base -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.0125" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.025"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <!-- Joint 1: base rotation (yaw) -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="1"/>
  </joint>

  <!-- Link 1: vertical column -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.18"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- Joint 2: shoulder pitch -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="10" velocity="1"/>
  </joint>

  <!-- Link 2: upper arm (horizontal) -->
  <link name="link2">
    <visual>
      <origin xyz="0.075 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.15"/>
      </geometry>
      <material name="green"/>
    </visual>
  </link>

  <!-- Joint 3: elbow pitch -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.15 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="10" velocity="1"/>
  </joint>

  <!-- Link 3: forearm (horizontal) -->
  <link name="link3">
    <visual>
      <origin xyz="0.06 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.12"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>

  <!-- Joint 4: wrist roll (added DOF) -->
  <joint name="joint4_wrist_roll" type="revolute">
    <parent link="link3"/>
    <child link="wrist_link"/>
    <origin xyz="0.12 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="5" velocity="1"/>
  </joint>

  <!-- Wrist link -->
  <link name="wrist_link">
    <visual>
      <origin xyz="0.015 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.03"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <!-- Fixed mount to gripper base -->
  <joint name="joint5_gripper_mount" type="fixed">
    <parent link="wrist_link"/>
    <child link="gripper_base"/>
    <origin xyz="0.03 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Gripper base -->
  <link name="gripper_base">
    <visual>
      <origin xyz="0.01 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.05 0.02"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
  </link>

  <!-- Joint 6: right finger (prismatic, added DOF) -->
  <joint name="joint6_finger_right" type="prismatic">
    <parent link="gripper_base"/>
    <child link="finger_right"/>
    <origin xyz="0.02 0.015 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.015" effort="5" velocity="0.1"/>
  </joint>

  <!-- Right finger -->
  <link name="finger_right">
    <visual>
      <origin xyz="0.015 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.008 0.015"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- Joint 7: left finger (prismatic, added DOF) -->
  <joint name="joint7_finger_left" type="prismatic">
    <parent link="gripper_base"/>
    <child link="finger_left"/>
    <origin xyz="0.02 -0.015 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.015" effort="5" velocity="0.1"/>
  </joint>

  <!-- Left finger -->
  <link name="finger_left">
    <visual>
      <origin xyz="0.015 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.008 0.015"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

</robot>
